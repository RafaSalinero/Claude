{
  "rules": {
    ".read": false,
    ".write": false,
    "groups": {
      "$group": {
        ".read": true,
        ".write": true,
        "people": {
          "$uid": {
            ".validate": "newData.hasChildren(['name','lat','lng','t']) && newData.child('name').isString() && newData.child('name').val().length <= 18 && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
          }
        },
        "pins": {
          "$pin": {
            ".validate": "newData.hasChildren(['name','lat','lng']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
